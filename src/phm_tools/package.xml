<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>phm_tools</name>
  <version>0.2.0</version>
  <description>
    Header-only helpers for the Policy Health Monitor's offline tools: a JSON
    value / parser / writer whose output matches Python's json.dumps, and a
    small dependency-free SVG chart writer. ROS-independent.
  </description>
  <maintainer email="yusuf.a.guenena@gmail.com">Yusuf Guenena</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>phm_core</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
